# Copy to `.env` and fill in the values.
# Only SCRAPFLY_API_KEY is strictly required for the standalone runner
# (python run_scraper.py urls.txt).

# ── Scrapfly ────────────────────────────────────────────────
SCRAPFLY_API_KEY=xxx

# ── Speed tuning (all optional) ─────────────────────────────
# Hard cap on concurrent requests (the engine also respects the
# account's own concurrent_limit, whichever is smaller).
SCRAPFLY_MAX_CONCURRENCY=30
# Used only if the account limit cannot be queried.
SCRAPFLY_FALLBACK_CONCURRENCY=20
# Concurrency for the heavy JS rescue wave.
SCRAPFLY_JS_CONCURRENCY=8
# Default URL file for the standalone runner.
URLS_FILE=urls.txt

# ── MySQL (URLs in, results out, field config) ──────────────
# Plain MySQL connection:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=scraper
MYSQL_PASSWORD=scraperpass
MYSQL_NAME=scrapfly
# ...or Google Cloud SQL (legacy alternative):
# INSTANCE_DB=your-gcp-project:region:instance
# USER_DB=your-db-user
# PASSWORD_DB=your-db-password
# NAME_DB=your-db-name
# MELI_SCHMA=your-schema
# SERVICE_ACCOUNT_FILE=/path/to/service_account.json   (LOCAL runs only:
# on Cloud Run leave it unset - the job's attached service account is used)

# Results persistence mode:
#   legacy (default) -> UPDATE scrapped_competence + Google Sheet "Catalogo"
#   json             -> scraping_results (NOT IN USE YET - migration pending)
SCRAPE_RESULTS_MODE=legacy
LEGACY_TABLE=scrapped_competence

# Legacy Google Sheet (updated after the DB write):
# GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/XXXX/edit
# GOOGLE_SHEET_TAB=Catalogo

# Placeholder table names (see sql/schema.sql):
SCRAPE_URLS_TABLE=scraping_urls
SCRAPE_URL_COLUMN=url
SCRAPE_RESULTS_TABLE=scraping_results
SCRAPE_FIELDS_TABLE=scraping_field_config

# ── WhatsApp notifications (optional) ───────────────────────
TOKEN_WHAPI=
PHONE=

# ── Webhook auth (only needed for the webhook) ──────────────
SECRET_GUIAS=change-me
